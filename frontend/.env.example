# supabase = hosted persistence. mock = local in-memory demo data.
# live remains available for the legacy standalone API adapter.
VITE_API_MODE=supabase

# Browser-safe Supabase credentials used by Auth and the Supabase API adapter.
# Never expose a secret/service-role key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Mock mode only: start with the seed's users but no rigs or results, so every empty state is reachable.
# VITE_MOCK_EMPTY=true

# Server runtime only (configure in Vercel, not the client bundle):
# SUPABASE_SECRET_KEY=sb_secret_your_server_key
# SUPABASE_URL can reuse VITE_SUPABASE_URL. See docs/AGENT_API_OPERATIONS.md.
