{
  "name": "intelinside-frontend",
  "version": "0.1.0",
  "description": "Front end for Intelinside, the community leaderboard of AI inference on Intel hardware.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "marks": "node scripts/generate-marks.mjs",
    "catalog:validate": "node scripts/validate-catalog.mjs",
    "catalog:seed": "node scripts/generate-catalog-seed.mjs",
    "results:validate": "node scripts/validate-results.mjs",
    "og:assets": "node scripts/generate-og-assets.mjs",
    "og:preview": "node scripts/og-preview.mjs",
    "supabase:db:push:prod:dry-run": "supabase --workdir .. db push --project-ref ujlacyedspjfekotemmd --dry-run --skip-vault",
    "results:test": "node --test scripts/tests/pr-results.test.mjs scripts/tests/catalog-sync.test.mjs scripts/tests/result-evidence.test.mjs scripts/tests/hardware-chart.test.mjs scripts/tests/supabase-fetch.test.mjs scripts/tests/rig-presentation.test.mjs scripts/tests/board-submissions.test.mjs scripts/tests/agent-api.test.mjs",
    "supabase:db:push:prod": "supabase --workdir .. db push --project-ref ujlacyedspjfekotemmd --skip-vault",
    "agents:test": "node --test scripts/tests/agent-api.test.mjs",
    "agents:docs": "node scripts/generate-agent-docs.mjs",
    "agents:docs:check": "node scripts/generate-agent-docs.mjs --check",
    "agents:dev": "node scripts/agent-api/dev.mjs",
    "agents:e2e": "playwright test",
    "agents:postgres": "node scripts/agent-api/native-postgres.mjs"
  },
  "license": "MIT",
