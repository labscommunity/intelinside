    "react-router-dom": "^7.18.3",
    "recharts": "^3.8.0",
    "shadcn": "^4.20.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
