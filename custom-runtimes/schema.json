{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/labscommunity/intelinside/main/custom-runtimes/schema.json",
  "title": "Custom runtime registration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtime",
    "name",
    "repoUrl",
    "summary"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "runtime": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "\\S"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "\\S"
    },
    "repoUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://\\S+$",
      "format": "uri"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280,
      "pattern": "\\S"
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000,
      "pattern": "\\S"
    }
  }
}
